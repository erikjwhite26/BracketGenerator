@page "/statsadmin"
@attribute [Authorize(Roles = "Admin")]
@using BlazorApp.Data
@using BlazorApp.Entities
@using Microsoft.AspNetCore.Authorization
@inject IJSRuntime JS
@inject FirestoreCacheService cache

<PageTitle>Stats Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-10">

    <MudGrid GutterSize="3">
        
        <!-- Historical Men's Stats -->
        <MudItem xs="12">
            <AuthorizeView>
                <Authorized>
                    <MudItem xs="12" Class="ml-auto">
                        <MudButton Variant="Variant.Filled"
                                Size="Size.Large"
                                FullWidth="true"
                                Color="Color.Success"
                                @onclick="() => SaveStat(Constants.STATS_HISTORIC, HistoricStats)">
                            Save Historical Men's Stats
                        </MudButton>
                    </MudItem>
                </Authorized>
            </AuthorizeView>
            <MudCard Elevation="3" Class="pa-4 h-100"
                     Style="background-color: rgba(255,255,255,0.85); backdrop-filter: blur(4px); border-radius: 12px; overflow-x: scroll;">
                <MudCardContent>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Medium" Class="mr-2" />
                        <MudText Typo="Typo.h5">Historical Men's Stats</MudText>
                    </MudStack>

                    <div class="stats-table-wrapper">
                        <table class="stat-table">
                            <thead>
                                <tr>
                                    <th>Seeds</th>
                                    @foreach (var seed in HistoricStats)
                                    {
                                        <td>@seed.Id</td>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var seed in HistoricStats)
                                {
                                    <tr>
                                        <th>@seed.Id</th>
                                        @foreach (var stat in seed.Stats)
                                        {
											int seedIdInt = int.TryParse(seed.Id, out var parsed) ? parsed : -1;
											<td class="@((stat.Id == seedIdInt) ? "highlight-cell" : "")">
                                                <input class="stat-input"
                                                    value="@stat.Probability"
                                                    @oninput='e => stat.Probability = double.Parse(e.Value?.ToString() ?? "0")' />
											</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Historical Women's Stats -->
        <MudItem xs="12">
            <AuthorizeView>
                <Authorized>
                    <MudItem xs="12" Class="ml-auto">
                        <MudButton Variant="Variant.Filled"
                                Size="Size.Large"
                                FullWidth="true"
                                Color="Color.Success"
                                @onclick="() => SaveStat(Constants.STATS_HISTORIC_W, HistoricStatsW)">
                            Save Historical Women's Stats
                        </MudButton>
                    </MudItem>
                </Authorized>
            </AuthorizeView>
            <MudCard Elevation="3" Class="pa-4 h-100"
                     Style="background-color: rgba(255,255,255,0.85); backdrop-filter: blur(4px); border-radius: 12px; overflow-x: scroll;">
                <MudCardContent>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Medium" Class="mr-2" />
                        <MudText Typo="Typo.h5">Historical Women's Stats</MudText>
                    </MudStack>

                    <div class="stats-table-wrapper">
                        <table class="stat-table">
                            <thead>
                                <tr>
                                    <th>Seeds</th>
                                    @foreach (var seed in HistoricStatsW)
                                    {
                                        <td>@seed.Id</td>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var seed in HistoricStatsW)
                                {
                                    <tr>
                                        <th>@seed.Id</th>
                                        @foreach (var stat in seed.Stats)
                                        {
											int seedIdInt = int.TryParse(seed.Id, out var parsed) ? parsed : -1;
											<td class="@((stat.Id == seedIdInt) ? "highlight-cell" : "")">
                                                <input class="stat-input"
                                                    value="@stat.Probability"
                                                    @oninput='e => stat.Probability = double.Parse(e.Value?.ToString() ?? "0")' />
											</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- 538 Men's Stats -->
        <MudItem xs="12">
            <AuthorizeView>
                <Authorized>
                    <MudGrid>
                        <MudItem xs="6" Class="ml-auto">
                            <MudButton Variant="Variant.Filled"
                                    Size="Size.Large"
                                    FullWidth="true"
                                    Color="Color.Success"
                                    @onclick="() => SaveStat(Constants.STATS_538, FiveThirtyEightOdds)">
                                Save 538 Men's Stats
                            </MudButton>
                        </MudItem>
                        <MudItem xs="6" Class="ml-auto">
                            <MudButton Variant="Variant.Filled"
                                    Size="Size.Large"
                                    FullWidth="true"
                                    Color="Color.Warning"
                                    @onclick="() => ResetStat(Constants.STATS_538)">
                                Reset 538 Men's Stats
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </Authorized>
            </AuthorizeView>
            <MudCard Elevation="3" Class="pa-4 h-100"
                     Style="background-color: rgba(255,255,255,0.85); backdrop-filter: blur(4px); border-radius: 12px; overflow-x: scroll;">
                <MudCardContent>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Medium" Class="mr-2" />
                        <MudText Typo="Typo.h5">538 Men's Stats</MudText>
                    </MudStack>

                    <div class="stats-table-wrapper">
                        <table class="stat-table">
                            <thead>
                                <tr>
                                    <th>Team/Round</th>
                                    <td>2</td><td>3</td><td>4</td><td>5</td><td>6</td><td>7</td>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var statDetails in FiveThirtyEightOdds)
                                {
                                    <tr>
                                        <th>
                                            <input class="stat-input"
                                                value="@statDetails.Id"
                                                @oninput="e => statDetails.Id = e.Value?.ToString() ?? string.Empty" />
                                        </th>
                                        @foreach (var stat in statDetails.Stats)
                                        {
                                            <td>
                                                <input class="stat-input"
                                                    value="@stat.Probability"
                                                    @oninput='e => stat.Probability = double.Parse(e.Value?.ToString() ?? "0")' />
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- 538 Women's Stats -->
        <MudItem xs="12">
            <AuthorizeView>
                <Authorized>
                    <MudGrid>
                        <MudItem xs="6" Class="ml-auto">
                            <MudButton Variant="Variant.Filled"
                                    Size="Size.Large"
                                    FullWidth="true"
                                    Color="Color.Success"
                                    @onclick="() => SaveStat(Constants.STATS_538_W, FiveThirtyEightOddsW)">
                                Save 538 Women's Stats
                            </MudButton>
                        </MudItem>
                        <MudItem xs="6" Class="ml-auto">
                            <MudButton Variant="Variant.Filled"
                                    Size="Size.Large"
                                    FullWidth="true"
                                    Color="Color.Warning"
                                    @onclick="() => ResetStat(Constants.STATS_538_W)">
                                Reset 538 Women's Stats
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </Authorized>
            </AuthorizeView>
            <MudCard Elevation="3" Class="pa-4 h-100"
                     Style="background-color: rgba(255,255,255,0.85); backdrop-filter: blur(4px); border-radius: 12px; overflow-x: scroll;">
                <MudCardContent>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Medium" Class="mr-2" />
                        <MudText Typo="Typo.h5">538 Women's Stats</MudText>
                    </MudStack>

                    <div class="stats-table-wrapper">
                        <table class="stat-table">
                            <thead>
                                <tr>
                                    <th>Team/Round</th>
                                    <td>2</td><td>3</td><td>4</td><td>5</td><td>6</td><td>7</td>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var statDetails in FiveThirtyEightOddsW)
                                {
                                    <tr>
                                        <th>
                                            <input class="stat-input"
                                                value="@statDetails.Id"
                                                @oninput="e => statDetails.Id = e.Value?.ToString() ?? string.Empty" />
                                        </th>
                                        @foreach (var stat in statDetails.Stats)
                                        {
                                            <td>
                                                <input class="stat-input"
                                                    value="@stat.Probability"
                                                    @oninput='e => stat.Probability = double.Parse(e.Value?.ToString() ?? "0")' />
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </MudCardContent>
            </MudCard>
        </MudItem>

    </MudGrid>

</MudContainer>

@code {
    private List<StatDetails> HistoricStats = new();
    private List<StatDetails> HistoricStatsW = new();
    private List<StatDetails> FiveThirtyEightOdds = new();
    private List<StatDetails> FiveThirtyEightOddsW = new();

    async Task<List<StatDetails>> RetrieveStat(string statId)
    {
        try
        {
            var statGroup = new StatGroup();
            var statGroupRs = await cache.GetCachedAsync(
                statId,
                () => JS.InvokeAsync<StatGroup>(
                    Constants.FUNCTION_RETRIEVE_STATS,
                    statId,
                    statGroup
                ).AsTask()
            );
            return statGroupRs.StatDetails;
        }
        catch (Exception e)
        {
            Console.Write(e);
        }
        return [];
    }
    
    private async Task<bool> SaveStat(string statId, List<StatDetails> statDetails)
    {
        try
        {
            await JS.InvokeVoidAsync(Constants.FUNCTION_ADD_STAT, statId, HelperFunctions.ConvertStats(statDetails));
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
        return true;
    }

    private async Task<bool> ResetStat(string statId){
        try{
            var teams = new List<string>();
            if(statId == Constants.STATS_538)
            {
                teams = await GetTeams(Constants.BRACKET_MEN);
                teams.Zip(FiveThirtyEightOdds, (team, stat) => stat.Id = team).ToList();
                FiveThirtyEightOdds = FiveThirtyEightOdds.OrderBy(s => s.Id).ToList();
            } 
            else if(statId == Constants.STATS_538_W)
            {
                teams = await GetTeams(Constants.BRACKET_WOMEN);
                teams.Zip(FiveThirtyEightOddsW, (team, stat) => stat.Id = team).ToList();
                FiveThirtyEightOddsW = FiveThirtyEightOddsW.OrderBy(s => s.Id).ToList();
            }
			StateHasChanged();            
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
        return true;
    }

	async Task<List<string>> GetTeams(string bracketId){
		try{
			var tourneyGroup = new TourneyGroup();
			var tourneyGroupRs = await JS.InvokeAsync<TourneyGroup>(Constants.FUNCTION_RETRIEVE_BRACKETS, bracketId, tourneyGroup);
			return tourneyGroupRs.RegionalMatchupGroups
                .SelectMany(r => r.RegionalMatchupDetails.RegionalMatchups)
                .SelectMany(m => new[] { m.Matchup.Team1.Name, m.Matchup.Team2.Name })
                .Where(name => !string.IsNullOrWhiteSpace(name))
                .SelectMany(name => name.Split('/', StringSplitOptions.RemoveEmptyEntries)
                                        .Select(n => n.Trim()))
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Distinct()
                .ToList();
		}
		catch(Exception e){
			Console.Write(e);
		}
		return [];
	}

    protected override async Task OnInitializedAsync()
    {
        HistoricStats = await RetrieveStat(Constants.STATS_HISTORIC);
        FiveThirtyEightOdds = (await RetrieveStat(Constants.STATS_538)).OrderBy(s => s.Id).ToList();
        HistoricStatsW = await RetrieveStat(Constants.STATS_HISTORIC_W);
        FiveThirtyEightOddsW = (await RetrieveStat(Constants.STATS_538_W)).OrderBy(s => s.Id).ToList();
    }
}